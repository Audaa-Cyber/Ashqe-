# X (Twitter) OAuth
X_CLIENT_ID=your_client_id_here
X_CLIENT_SECRET=your_client_secret_here
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# Public X variables (safe to expose in NEXT_PUBLIC_*)
NEXT_PUBLIC_X_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here
